# Settings for building the front end for AWS. Copy to .env.production before `npm run build`.
# These values are public (they end up in the browser), so they are not secrets.

VITE_AUTH_MODE=cognito
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=https://northwind-hr.auth.us-east-1.amazoncognito.com
