# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# .env is in .gitignore, so it is never committed. Keep it that way: it holds a secret key.
#
# Langfuse: your project > Settings > API Keys. Read by scripts/set-langfuse-keys.sh, which
# stores the keys in AWS Secrets Manager for the application, and by pipeline/trace.py.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# US region: https://us.cloud.langfuse.com   EU region: https://cloud.langfuse.com
# Pasting Langfuse's own snippet (Settings > API Keys) works too: it says LANGFUSE_BASE_URL.
LANGFUSE_HOST=https://us.cloud.langfuse.com
